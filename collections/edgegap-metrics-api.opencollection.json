{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edgegap Arbitrium App Versions Metrics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get deployment metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.edgegap.com/v1/metrics/deployment/:deployment_id",
            "params": [
              {
                "name": "deployment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns monitoring telemetry (CPU, memory, network) for a deployment."
        }
      ]
    }
  ],
  "bundled": true
}